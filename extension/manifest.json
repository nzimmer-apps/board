{
  "manifest_version": 3,
  "name": "Board \u2014 quick capture",
  "version": "0.2.0",
  "description": "Send text, links and pages to your Board.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Add to Board"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "contextMenus",
    "storage",
    "notifications",
    "activeTab"
  ],
  "host_permissions": [
    "https://*.supabase.co/*",
    "<all_urls>"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+B"
      },
      "description": "Open quick add"
    }
  },
  "icons": {
    "16": "icon-16.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  }
}